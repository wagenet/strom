module mod //! (keeps the file's own header)
module endpoint //! Per-endpoint configuration and slot allocation.
module activity //! Session liveness: the activity stamps and how a session is judged idle.
module takeover //! Slot takeover: displacing a session that no longer produces usable media.
module test_support #[cfg(test)] //! Fixtures shared by the session manager's tests.

