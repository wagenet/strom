# Split of whip.rs and whip_session_manager.rs into directory modules.
# Every item is listed, including items from open PRs not yet on
# upstream/main (marked with the PR); split.py refuses to run if the source
# has an item this file does not place.

source backend/src/blocks/builtin/whip.rs
module mod //! (keeps the file's own header)
module slot_chain //! WHIP Input per-slot output chains, built once with the flow.
module watchdog //! Per-session inactivity watchdog for WHIP Input.
module session //! One isolated whipserversrc pipeline per WHIP client session, bridged into its slot.
module output //! WHIP Output: whipclientsink and the legacy whipsink.
module definition //! WHIP Output and WHIP Input block definitions.

/fn slot_audio_caps = slot_chain
/fn lock_slot_audio_caps = slot_chain
/struct WHIPOutputBuilder = mod
/struct WHIPInputBuilder = mod
impl BlockBuilder for WHIPOutputBuilder/fn build = mod
impl BlockBuilder for WHIPInputBuilder/fn build = mod
impl BlockBuilder for WHIPInputBuilder/fn get_external_pads = mod
/fn parse_jitterbuffer_latency_ms = slot_chain
/fn parse_do_retransmission = slot_chain
/fn parse_drop_on_latency = slot_chain
/fn prepare_idle_decodebin = slot_chain
/fn stamp_slot_output = slot_chain
/fn build_whipserversrc = slot_chain
/const INACTIVITY_TIMEOUT = watchdog
/const _ = watchdog
/const WATCHDOG_POLL = watchdog
/fn wait_until_deadline_or_stop = watchdog
/fn wait_for_inactivity = watchdog
# from #787
/fn attach_session_branch = session
# from #759
/fn install_slot_bridge = session
/struct CreatedSession = session
/fn create_whipserversrc_for_session = session
/fn forward_sample_to_slot = session
/fn build_whipclientsink = output
/fn build_whipsink = output
/fn get_blocks = definition
/fn whip_output_definition = definition
/fn whip_input_definition = definition
/fn setup_incoming_rtp_handler = output
tests/fn props = slot_chain
tests/fn jitterbuffer_latency_ms_defaults_to_400 = slot_chain
tests/fn jitterbuffer_latency_ms_respects_explicit_value = slot_chain
tests/fn jitterbuffer_latency_ms_clamps_negative_to_zero = slot_chain
tests/fn do_retransmission_defaults_to_true = slot_chain
tests/fn do_retransmission_respects_explicit_true = slot_chain
tests/fn drop_on_latency_defaults_to_true = slot_chain
tests/fn drop_on_latency_respects_explicit_false = slot_chain
tests/fn do_retransmission_respects_explicit_false = slot_chain
tests/fn watchdog_wait_returns_as_soon_as_the_stop_flag_is_set = watchdog
tests/fn watchdog_wait_runs_to_the_deadline_when_not_stopped = watchdog
tests/fn watchdog_detects_inactivity_within_one_poll_of_the_timeout = watchdog
tests/fn watchdog_inactivity_wait_gives_up_when_stopped = watchdog
tests/fn watchdog_reaps_a_session_that_receives_media_it_never_decodes = watchdog
tests/fn assemble = slot_chain
tests/fn i420_frame = slot_chain
tests/fn wait_for = slot_chain
tests/fn the_slot_stamp_follows_media_out_of_the_decode_chain_not_into_it = slot_chain
